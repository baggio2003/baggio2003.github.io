\newlabel{fig:trw_trajectories}{{5.2}{9}{Verified sample trajectories of the TRW statistic $\Lambda _n$ ($\theta _0=0.10, \theta _1=0.80, \alpha =10^{-4}, \beta =10^{-2}$) compared with fixed-window sizes $N_{\mathrm {CLT}}=9$ and exact Binomial $N_{\mathrm {Bin}}=13$}{figure.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.2}{\ignorespaces Detection sample sizes across scanner profiles ($\theta _0 = 0.10, \alpha = 10^{-4}, \beta = 10^{-2}$): KL drift $D_{\mathrm  {KL}}(P_1 \parallel P_0)$, asymptotic $N_{\mathrm  {CLT}}$ (Eq.~\eqref  {eq:n_clt}), exact Binomial $N_{\mathrm  {Bin}}$, Wald $\mathbb  {E}_{H_1}[\tau ]$ (Eq.~\eqref  {eq:expected_tau}), Monte Carlo $\hat  {\mu }_\tau \pm \hat  {\sigma }_\tau $ ($10^4$ trials), and speedup $N_{\mathrm  {Bin}}/\hat  {\mu }_\tau $.}}{9}{table.caption.5}\protected@file@percent }
\newlabel{tab:clt_vs_trw}{{5.2}{9}{Detection sample sizes across scanner profiles ($\theta _0 = 0.10, \alpha = 10^{-4}, \beta = 10^{-2}$): KL drift $\DKL (P_1 \parallel P_0)$, asymptotic $N_{\mathrm {CLT}}$ (Eq.~\eqref {eq:n_clt}), exact Binomial $N_{\mathrm {Bin}}$, Wald $\E _{H_1}[\tau ]$ (Eq.~\eqref {eq:expected_tau}), Monte Carlo $\hat {\mu }_\tau \pm \hat {\sigma }_\tau $ ($10^4$ trials), and speedup $N_{\mathrm {Bin}}/\hat {\mu }_\tau $}{table.caption.5}{}}
