\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Experiment 1: Numerical Stability of Streaming Variance Estimators}{8}{subsection.0.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Empirical relative error $\mathcal  {E}_{\mathrm  {rel}}$ ($n=10^5$, $\sigma =1$) vs.\ clock offset $C$. Naive variance diverges with slope $2$ ($\mathcal  {O}(nu\kappa ^2)$), clipping above $10^4$ in \texttt  {float32} at $C \ge 10^4$, whereas Welford degrades linearly ($\mathcal  {O}(nu\kappa )$).}}{8}{figure.caption.2}\protected@file@percent }
\newlabel{fig:welford_vs_naive}{{5.1}{8}{Empirical relative error $\mathcal {E}_{\mathrm {rel}}$ ($n=10^5$, $\sigma =1$) vs.\ clock offset $C$. Naive variance diverges with slope $2$ ($\mathcal {O}(nu\kappa ^2)$), clipping above $10^4$ in \texttt {float32} at $C \ge 10^4$, whereas Welford degrades linearly ($\mathcal {O}(nu\kappa )$)}{figure.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.1}{\ignorespaces Empirical relative variance error $\mathcal  {E}_{\mathrm  {rel}}$ over $n = 10^5$ packets ($\sigma ^2 = 1.0$, seed \texttt  {2026}). Entries marked $(\dagger )$ denote strictly negative variance estimates $\hat  {s}_n^2 < 0$ (producing \texttt  {NaN} in standard deviation / $Z$-score computation).}}{8}{table.caption.3}\protected@file@percent }
\newlabel{tab:welford_benchmark}{{5.1}{8}{Empirical relative variance error $\mathcal {E}_{\mathrm {rel}}$ over $n = 10^5$ packets ($\sigma ^2 = 1.0$, seed \texttt {2026}). Entries marked $(\dagger )$ denote strictly negative variance estimates $\hat {s}_n^2 < 0$ (producing \texttt {NaN} in standard deviation / $Z$-score computation)}{table.caption.3}{}}
